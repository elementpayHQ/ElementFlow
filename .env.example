# ---------------------------------------------------------------- network access
PRIVATE_KEY=
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASESCAN_API_KEY=

# ------------------------------------------------------------------ roles
# Env keys are prefixed with the uppercased hardhat network name (- becomes _),
# e.g. BASE_SEPOLIA_ADMIN_ADDRESS for --network base-sepolia.
#
# In production these MUST be four distinct addresses. Deployment falls back to the
# deployer for any that are unset, which is fine for a local run and unacceptable on
# mainnet. ADMIN should be a multisig, ideally behind a timelock.

# Governance: holds DEFAULT_ADMIN_ROLE, UPGRADER_ROLE, PAUSER_ROLE, TREASURER_ROLE.
BASE_SEPOLIA_ADMIN_ADDRESS=
# Backend settlement key: holds AGGREGATOR_ROLE and ORDER_CREATOR_ROLE. Hot key.
BASE_SEPOLIA_AGGREGATOR_ADDRESS=
# Receives settled off-ramp principal.
BASE_SEPOLIA_TREASURY_ADDRESS=
# Receives protocol fees. Separate from treasury so revenue and float can be custodied apart.
BASE_SEPOLIA_FEE_RECIPIENT_ADDRESS=

BASE_ADMIN_ADDRESS=
BASE_AGGREGATOR_ADDRESS=
BASE_TREASURY_ADDRESS=
BASE_FEE_RECIPIENT_ADDRESS=

# ------------------------------------------------------------------ configuration
# Protocol fee in basis points of MAX_BPS = 100000. So 1000 = 1%. Hard cap is 5000 (5%).
FEE_BPS=0
# Seconds until an order becomes permissionlessly refundable. Must exceed your settlement
# SLA with margin, or a slow settlement can be front-run by an expiry refund.
# Bounds: 900 (15m) .. 2592000 (30d).
ORDER_TTL=3600
# Comma-separated ERC20 addresses to allowlist at deploy time.
ALLOWED_TOKENS=

# ------------------------------------------------- upgrade-v1-to-v2.js / scan-legacy-orders.js
# Live v1 proxy being upgraded or scanned.
PROXY_ADDRESS=
# Block the v1 proxy was deployed at, to bound the log scan.
FROM_BLOCK=
# Pending v1 off-ramp escrow, as 0xToken:amount pairs. Produced by scan-legacy-orders.js.
# Omitting this lets v2 treat live user escrow as spendable house float — see the script
# header before setting it.
LEGACY_ESCROW=

# ------------------------------------------------------------------ tooling
REPORT_GAS=
